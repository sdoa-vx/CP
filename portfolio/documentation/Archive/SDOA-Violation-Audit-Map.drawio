        <object label="Blueprint.feature&#10;savant · Browser" Purpose="Draggable SVG node graph of the live registry; Event-to-Accept port wiring saved as a schema." id="blueprint_feat"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284b8a;strokeColor=#1a3360;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1570" y="720" width="230" height="60" as="geometry"/></mxCell></object>
