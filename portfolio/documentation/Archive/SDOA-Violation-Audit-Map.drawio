        <object label="⚠ AuthListener.service&#10;service · NodeJS" Purpose="Local HTTP server capturing OAuth callback codes (Google Drive auth)." ViolationType="MISSING MANIFEST" Severity="Medium" ExpectedRule="Manifest 3.1/3.2: every touched file carries a v1.2 manifest or declares non-sdoa-compliant:true." ActualBehavior="No formal MANIFEST block; binds :3000 (collides with Dashboard default port)." FixItAction="Add a v1.2 MANIFEST (id AuthListener.service) or mark non-sdoa-compliant; move off the Dashboard :3000 port." id="authlistener"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a6a1f;strokeColor=#ffb000;strokeWidth=2;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="290" y="1570" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="BackendConnector (service)&#10;service · JS" Purpose="Tauri IPC transport service: runs backend workflows, monitors/reconnects sidecar." Violations="Browser-runtime sibling of the MISSING NodeJS BackendConnector that LlmBridge/LlmPolicyEngine/BunInstaller require (see V4)." id="backendconnector_svc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a5a5a;strokeColor=#3a3a3a;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="540" y="1570" width="230" height="58" as="geometry"/></mxCell></object>
