        <object label="⚠ Middleware.service&#10;service · NodeJS" Purpose="Static logging middleware for the IPC server: stderr logging + log rotation." ViolationType="MISSING MANIFEST" Severity="Medium" ExpectedRule="Manifest 3.1/3.2: every touched file carries a v1.2 manifest (8 mandatory fields) or explicitly declares non-sdoa-compliant:true." ActualBehavior="No formal MANIFEST block; not registry-discoverable; undeclared non-compliance." FixItAction="Add a v1.2 MANIFEST (id Middleware.service, type service) or mark non-sdoa-compliant:true." id="middleware"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a6a1f;strokeColor=#ffb000;strokeWidth=2;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1290" y="970" width="230" height="58" as="geometry"/></mxCell></object>
