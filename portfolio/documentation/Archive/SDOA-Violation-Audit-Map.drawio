        <object label="⚠ blueprint.schema.json&#10;artifact · data" Purpose="Generated Drift Map snapshot: nodes + requires/event connections, rendered by Dashboard + Blueprint UI." ViolationType="SNAPSHOT DRIFT" Severity="Low" ExpectedRule="Generated artifacts must match the live manifest surface (Cartographer.diff = source of truth)." ActualBehavior="Stored nodes reflect an earlier registration set (e.g. Registry.service shows registerPolyglot + empty operationalRole) differing from current source." FixItAction="Regenerate via VisualOrchestrator on every registry:moduleRegistered; gate commits with Cartographer.diff in CI." id="blueprint_json"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6f6a3a;strokeColor=#e0c000;strokeWidth=2;fontColor=#ffffff;fontSize=11;spacing=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="2070" y="720" width="210" height="60" as="geometry"/></mxCell></object>
