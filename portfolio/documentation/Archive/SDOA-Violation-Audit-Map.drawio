        <object label="CommentaryPool.service&#10;savant · NodeJS" Purpose="Parallel side-channel commentary worker pool across personas." id="commentarypool"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a6b6b;strokeColor=#2f4a4a;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="790" y="1090" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ LlmBridge&#10;adapter · NodeJS" Purpose="Fail-over LLM adapter routing via LlmPolicyEngine + BackendConnector." ViolationType="MISSING-AWAIT + UNRESOLVED CONNECTOR" Severity="High" ExpectedRule="Async lifecycle contract + Gate 5 (await all async); 3.1 dependencies must reference real registered ids (Registry.initAll throws SDOA Graph Error on missing dep)." ActualBehavior="Calls async resolveRoute() WITHOUT await (policy.primary undefined on a Promise); requires a NodeJS BackendConnector that does not exist (only Browser BackendConnector.ui); hardcoded final fallback ollama/llama3 not in policy." FixItAction="await resolveRoute(); field a NodeJS BackendConnector sovereign or repoint require[] to AiProvider/LlmConnector; add assertionSuite." id="llmbridge"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1040" y="1090" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="WorkflowRegistry / Instance&#10;registry · NodeJS" Purpose="Synchronous Map-based registration/lookup for operational workflows (singleton)." id="workflowregistry"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1d4d78;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1290" y="1090" width="230" height="58" as="geometry"/></mxCell></object>

        <object label="⚠ LocalLlmServer.engine&#10;savant · Python" Purpose="Local Qwen inference HTTP server (ThreadingHTTPServer) on port 17892." ViolationType="DUPLICATE/CONFLICTING ENGINE REGISTRATION" Severity="High" ExpectedRule="Manifest 3.1 (no two modules share an id); Dedup 9.1/9.2 (same name+ext = variant; +size = exact duplicate -> delete); one champion engine per capability/port." ActualBehavior="Exposes identical /generate + /health contract on the SAME default port 17892 as qwen_server.py, with conflicting id/version (LocalLlmServer.engine 5.0.0 vs qwen_server.engine 1.2.0)." FixItAction="Keep one canonical engine; move the other to variants/ with variant_of (or delete exact dup per 9.2); assign distinct ports; let Registrar field a single champion." id="localllm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ qwen_server.engine&#10;savant · Python" Purpose="ProtoAI local Qwen inference HTTP server (functionally identical to LocalLlmServer.engine)." ViolationType="DUPLICATE/CONFLICTING ENGINE REGISTRATION" Severity="High" ExpectedRule="Manifest 3.1 unique ids; Dedup 9.1/9.2; single champion engine per capability/port." ActualBehavior="Same /generate + /health on default port 17892 as LocalLlmServer.engine; id qwen_server.engine v1.2.0 while sdoa field says 5.0.0 (manifest divergence)." FixItAction="Demote to variants/ (variant_of LocalLlmServer.engine) or delete; reconcile version/sdoa fields; distinct port." id="qwen"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="290" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ ContextEngine&#10;savant · Python" Purpose="Semantic retrieval engine: assembles refactor context from semantic + SQL queries." ViolationType="CROSS-RUNTIME ASYNC + SQL INJECTION" Severity="High" ExpectedRule="Cross-language calls go through the declarative manifest/PolyglotBridge with awaited serialized results; safe parameterized queries." ActualBehavior="Calls async Node QmdAdapter search()/query() synchronously across PolyglotBridge (returns a Promise/proxy, not a list -> res['score'] breaks); builds SQL via f-string interpolation (injection risk)." FixItAction="Await the bridge proxy and return serialized results; parameterize qmd.query; declare QmdAdapter in requires[]." id="contextengine"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="540" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ LlmPolicyEngine&#10;engine · NodeJS" Purpose="Governance engine resolving best model route per tier; persists routing policy." ViolationType="UNRESOLVED CONNECTOR" Severity="High" ExpectedRule="3.1 dependencies must reference real registered module ids; Registry.initAll throws SDOA Graph Error on missing dependency." ActualBehavior="requires[] BackendConnector and calls registry.get('BackendConnector') but no NodeJS BackendConnector sovereign exists (only Browser BackendConnector.ui)." FixItAction="Field a NodeJS BackendConnector sovereign, or repoint to a real workflow-runner; verify graph via Oracle before fielding." id="llmpolicy"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="790" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="CommandPalette.engine&#10;engine · Rust/Tauri" Purpose="Native global-hotkey engine toggling the SDOA palette window." id="cmdpalette_rs"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a5fb0;strokeColor=#523a7c;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1040" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ SystemHealth&#10;dashboard · Rust/Tauri" Purpose="Native Tauri shell dashboard window (SDOA System Control)." ViolationType="UNRESOLVED/ORPHANED DEPENDENCY" Severity="High" ExpectedRule="3.1 dependencies must reference real registered ids; naming consistency 8.2." ActualBehavior="Declares dependency ProvisioningService which does not exist in the tree (the provisioner sovereign is id BunInstaller)." FixItAction="Rename dependency to BunInstaller (or create a ProvisioningService alias sovereign); validate via Oracle whoHandles." id="systemhealth_rs"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1290" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="LlmConnector.adapter&#10;savant · NodeJS" Purpose="Low-level HTTPS + SSE transport to Anthropic/OpenAI-compatible providers." id="llmconnector"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a5a5a;strokeColor=#3a3a3a;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1540" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="TokenBudget.adapter&#10;savant · NodeJS" Purpose="Context-window budgeting: limit lookup, token estimation, trim-to-fit." id="tokenbudget"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a5a5a;strokeColor=#3a3a3a;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1790" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ QmdAdapter&#10;adapter · NodeJS" Purpose="Wraps the qmd CLI child process: semantic search, SQL query, embedding index." ViolationType="UNDER-DECLARED MANIFEST" Severity="Low" ExpectedRule="Manifest 3.1 / Action Surface: capabilities and actions must declare the real callable surface so Oracle/Interpreter can resolve it." ActualBehavior="MANIFEST capabilities and actions are empty despite exposing search/query/index." FixItAction="Populate capabilities (semantic.search/query/index) and actions.commands so the surface is discoverable." id="qmd"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6f6a3a;strokeColor=#e0c000;strokeWidth=2;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="2040" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ BunInstaller&#10;adapter · NodeJS" Purpose="Provisioning adapter ensuring the Bun runtime is installed/ready." ViolationType="UNRESOLVED CONNECTOR" Severity="High" ExpectedRule="3.1 dependencies must reference real registered module ids." ActualBehavior="requires[] BackendConnector (NodeJS) which is not a registered sovereign in this tree." FixItAction="Repoint to a real backend workflow-runner sovereign or field a NodeJS BackendConnector; verify dependency graph." id="buninstaller"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="2290" y="1210" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ RefactorService&#10;savant · Python" Purpose="Senior SDOA Architect: gets ContextEngine context, builds prompt, requests generation via LlmBridge." ViolationType="CROSS-RUNTIME ASYNC" Severity="High" ExpectedRule="Cross-language calls go through declarative manifest/PolyglotBridge with awaited serialized results." ActualBehavior="Python service calls async NodeJS LlmBridge.generate() synchronously across runtimes (returns Promise/proxy, not a string)." FixItAction="Await the bridge proxy; ensure LlmBridge returns a serialized string over PolyglotBridge; declare requires[] LlmBridge, ContextEngine." id="refactorservice"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="2540" y="1210" width="230" height="58" as="geometry"/></mxCell></object>

        <object label="BaseRepository&#10;repository · NodeJS" Purpose="Base FS repository with per-file write queues (concurrency-safe persistence base class)." id="baserepo"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="FsVfsRepository&#10;repository · NodeJS" Purpose="VFS persistence + manifest store (pointer-based, no copy); the manifest cache node." id="fsvfs"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="290" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="⚠ FsMemoryRepository&#10;repository · NodeJS" Purpose="Global + per-project memory (facts) JSON persistence." ViolationType="ORPHANED METHOD CALL (runtime throw)" Severity="High" ExpectedRule="3.1/Gate 5: a module may only call methods that exist on its declared dependencies; code must run." ActualBehavior="Calls paths.globalMemory() which is undefined on PathResolver (paths.js has memoryRoot/identityMemory but no globalMemory) -> throws at runtime." FixItAction="Add globalMemory() to PathResolver or call the existing memoryRoot()/identityMemory(); add a smoke test." id="fsmemory"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9a3b1f;strokeColor=#ff6a2a;strokeWidth=3;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="540" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="FsProfileRepository&#10;repository · NodeJS" Purpose="Profile persistence/resolution: merges legacy + archetype + user profiles into settings + system prompt." id="fsprofile"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="790" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="FsProjectRepository&#10;repository · NodeJS" Purpose="Project persistence: list, history append, chat sessions CRUD, structure walk, settings." id="fsproject"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1040" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="PathResolver (paths.js)&#10;service · NodeJS" Purpose="Canonical filesystem path resolver (data/projects/vfs/memory/profile builders)." Violations="MISSING METHOD: globalMemory() referenced by FsMemoryRepository is not defined here (see V4)." id="pathresolver"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1290" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
        <object label="permissions.js&#10;utility · NodeJS" Purpose="File-permissions CLI: per-project AI edit access with eager/cached/lazy tiers." id="permissions"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f6b4a;strokeColor=#274a30;fontColor=#ffffff;fontSize=11;spacing=3;" vertex="1" parent="1"><mxGeometry x="1540" y="1330" width="230" height="58" as="geometry"/></mxCell></object>
