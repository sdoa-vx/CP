{
    "capability": "gcd",
    "description": "Greatest common divisor of a and b.",
    "input_schema": {
        "type": "object",
        "properties": {
            "a": {
                "type": "integer"
            },
            "b": {
                "type": "integer"
            }
        },
        "required": [
            "a",
            "b"
        ]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "result": {
                "type": "integer"
            }
        },
        "required": [
            "result"
        ]
    }
}
